# Supabase Configuration
# Copy this file to .env or pass these as --dart-define flags when running flutter
# Example:
# flutter run --dart-define-from-file=.env

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Custom API Domain Routing
API_BASE_DOMAIN=https://smsgetway.techware.africa

# Swala SMS Provider (https://swalasms.com/sms/api-keys)
SWALA_SMS_BASE_URL=https://swalasms.com/api/v1
SWALA_SMS_API_KEY=your-swalasms-api-key-here
SWALA_SMS_SENDER_ID=SMS_GATEWAY

# Palm Pesa Tanzania Payment Gateway (https://palmpesa.drmlelwa.co.tz)
PALMPESA_BASE_URL=https://palmpesa.drmlelwa.co.tz
PALMPESA_USER_REF=USR-579470B9AB51
PALMPESA_API_TOKEN=your-palmpesa-api-token-here

# QuickSMS Provider (Optional fallback)
QUICKSMS_BASE_URL=https://api.quicksms.com.ng/v1
QUICKSMS_API_KEY=your-quicksms-api-key-here
